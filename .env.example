# ===========================================================================
# Velora — Copilote Conseiller (POC MCP) — Exemple de configuration
# Copiez ce fichier en `.env`  ->  `cp .env.example .env`
# ===========================================================================
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │ NOTE IMPORTANTE — Portabilité & test SANS clé payante                    │
# ├─────────────────────────────────────────────────────────────────────────┤
# │ L'agent IA de ce POC utilise l'API *compatible OpenAI*. Il fonctionne    │
# │ donc indifféremment avec :                                               │
# │   • un modèle LOCAL gratuit (Ollama ou LM Studio) → AUCUNE clé payante   │
# │   • l'API OpenAI (clé payante)                                           │
# │   • tout autre fournisseur compatible OpenAI (Groq, Together, OpenRouter)│
# │                                                                          │
# │ Pour changer de fournisseur, modifiez UNIQUEMENT les 3 variables LLM_*   │
# │ ci-dessous. Le serveur MCP, lui, ne dépend d'AUCUN LLM et n'a besoin     │
# │ d'aucune clé : il se teste seul via `npm test` ou via le MCP Inspector.  │
# │                                                                          │
# │ Pré-requis tool-calling : choisir un modèle qui supporte les « tools ».  │
# │ Reco locale fiable : Llama 3.1 (8B) via Ollama (cf. README).            │
# └─────────────────────────────────────────────────────────────────────────┘

# --- Base de données (SQLite locale, créée par `npm run db:setup`) ---
DATABASE_URL="file:./dev.db"

# ===========================================================================
# Fournisseur LLM — décommentez UN seul profil
# ===========================================================================

# ▶ Profil 1 — LOCAL via Ollama (GRATUIT, recommandé pour tester sans clé)
LLM_BASE_URL="http://localhost:11434/v1"
LLM_API_KEY="ollama"          # valeur factice : Ollama ignore la clé
LLM_MODEL="llama3.1"          # exécuter `ollama pull llama3.1` au préalable

# ▶ Profil 2 — OpenAI (clé payante)
# LLM_BASE_URL="https://api.openai.com/v1"
# LLM_API_KEY="sk-..."
# LLM_MODEL="gpt-4o-mini"

# ▶ Profil 3 — LM Studio (local, interface graphique)
# LLM_BASE_URL="http://localhost:1234/v1"
# LLM_API_KEY="lmstudio"
# LLM_MODEL="<nom-du-modele-charge-dans-LM-Studio>"

# --- Réglages optionnels de l'agent ---
LLM_TEMPERATURE="0.2"
AGENT_MAX_STEPS="6"           # nb max d'allers-retours tool-use avant réponse finale
